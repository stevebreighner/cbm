---
const { title = "Cards By Margaret" } = Astro.props;

import "../styles/global.css";
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Cards By Margaret — artwork, cards, and paintings by Margaret McKeough Breighner." />
  <title>{title}</title>

<style>
  #cart-indicator {
    display: none;
    position: absolute;
    top: 4px;
    right: 4px;
    width: 8px;
    height: 8px;
    background: #1976d2;
    border-radius: 50%;
    border: 2px solid white;
  }

  #cart-indicator.has-items {
    display: block;
  }
</style>
</head>

<body>

<header class="header">
  <a class="brand" href="/">CARDS BY MARGARET</a>

  <button class="hamburger" id="menuBtn" aria-label="Open menu">
    ☰
    <span id="cart-indicator" aria-hidden="true"></span>
  </button>
</header>

<div class="menu" id="menu">
  <nav>
    <a href="/">Home</a>
    <a href="/artwork">Artwork</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/cart/">Cart</a>
  </nav>
</div>

<main>
  <slot />
</main>

<footer class="footer">
  <span>© {new Date().getFullYear()} Cards By Margaret</span>&nbsp;
  <a href="/contact">Contact</a>&nbsp;<a href="/tos">Terms of Service</a>
</footer>

<script>
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("open");
  });

  menu?.addEventListener("click", (e) => {
    if (e.target === menu) {
      menu.classList.remove("open");
    }
  });

  const cartIndicator = document.getElementById("cart-indicator");

  function updateCartIndicator() {
    if (!cartIndicator) return;

    try {
      const cart = JSON.parse(localStorage.getItem("cbm-cart") || "[]");
      cartIndicator.classList.toggle("has-items", cart.length > 0);
    } catch {
      cartIndicator.classList.remove("has-items");
    }
  }

  updateCartIndicator();
  window.addEventListener("storage", updateCartIndicator);
</script>

</body>
</html>

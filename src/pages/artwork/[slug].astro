---
import PageLayout from "../../layouts/PageLayout.astro";

export function getStaticPaths() {
  const artwork = Object.entries(
    import.meta.glob("../../content/artwork/*.md", {
      eager: true,
    })
  );

  return artwork.map(([path, piece]) => ({
    params: {
      slug: path
        .split("/")
        .pop()
        .replace(".md", ""),
    },
    props: {
      piece,
    },
  }));
}

const { piece } = Astro.props;
const slug = Astro.params.slug;

const price = piece.frontmatter.price;
const status = piece.frontmatter.status ?? "Available";
const canBuy = price && status.toLowerCase() !== "sold";
---

<PageLayout title={piece.frontmatter.title}>

<a class="back" href="/artwork">
  ← Back
</a>

<h1>{piece.frontmatter.title}</h1>

<img
  class="hero-image"
  src={piece.frontmatter.image}
  alt={piece.frontmatter.title}
/>

{piece.frontmatter.medium && (
  <p>
    <strong>Medium:</strong>
    {piece.frontmatter.medium}
  </p>
)}

{piece.frontmatter.size && (
  <p>
    <strong>Size:</strong>
    {piece.frontmatter.size}
  </p>
)}

{price && (
  <p>
    <strong>Price:</strong>
    ${price}
  </p>
)}

{canBuy && (
  <div class="buy-form">
    <div class="quantity">
      <button id="qty-minus" type="button" aria-label="Decrease quantity">−</button>
      <span id="qty">1</span>
      <button id="qty-plus" type="button" aria-label="Increase quantity">+</button>
    </div>

    <button id="add-to-cart" type="button">
      Add to Cart
    </button>
  </div>
)}

<script define:vars={{ slug, title: piece.frontmatter.title, image: piece.frontmatter.image, price }}>
  const button = document.querySelector("#add-to-cart");
  const minus = document.querySelector("#qty-minus");
  const plus = document.querySelector("#qty-plus");
  const qtyDisplay = document.querySelector("#qty");

  let quantity = 1;
  const unitPrice = Number.parseFloat(price);

  function updateQuantity() {
    qtyDisplay.textContent = quantity;
    minus.disabled = quantity <= 1;
    plus.disabled = quantity >= 6;
  }

  minus?.addEventListener("click", () => {
    if (quantity > 1) {
      quantity--;
      updateQuantity();
    }
  });

  plus?.addEventListener("click", () => {
    if (quantity < 6) {
      quantity++;
      updateQuantity();
    }
  });

  button?.addEventListener("click", () => {
    const cart = JSON.parse(localStorage.getItem("cbm-cart") || "[]");

    const existing = cart.find((item) => item.slug === slug);

    if (existing) {
      existing.quantity = Math.min(
        (existing.quantity || 1) + quantity,
        6
      );
      existing.unitPrice =
        existing.unitPrice ?? Number.parseFloat(existing.price);
      existing.price = existing.unitPrice * existing.quantity;
    } else {
      cart.push({
        slug,
        title,
        image,
        unitPrice,
        price: unitPrice * quantity,
        quantity,
      });
    }

    localStorage.setItem("cbm-cart", JSON.stringify(cart));
    window.location.href = "/cart/";
  });

  updateQuantity();
</script>

<div class="content">
  <piece.Content />
</div>

</PageLayout>

<style>
.buy-form {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin: 1.25rem 0;
}

.quantity {
  display: flex;
  align-items: center;
  border: 1px solid var(--text);
}

.quantity button {
  width: 36px;
  height: 38px;
  padding: 0;
  border: 0;
  background: transparent;
  font: inherit;
  font-size: 1.2rem;
  cursor: pointer;
}

.quantity button:disabled {
  opacity: 0.35;
  cursor: default;
}

.quantity span {
  min-width: 30px;
  text-align: center;
}

#add-to-cart {
  appearance: none;
  border: 1px solid var(--text);
  background: var(--text);
  color: var(--bg);
  cursor: pointer;
  font: inherit;
  padding: 0.7rem 1rem;
}

#add-to-cart:hover {
  transform: translateY(-1px);
}

.hero-image {
  width: 100%;
  height: auto;
  max-height: 75vh;
  object-fit: contain;
  display: block;
  margin: 1rem auto;
}

@media (max-width: 768px) {
  .hero-image {
    max-height: 65vh;
  }
}

.content img {
  max-width: 100%;
  height: auto;
  display: block;
}

.page {
  padding: 1rem 1.25rem;
}
</style>
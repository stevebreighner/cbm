---

import PageLayout from "../layouts/PageLayout.astro";

const cards = [

{ slug: "cat", title: "Cat", image: "/images/cat.jpg" },
{ slug: "cows", title: "Cows", image: "/images/cows.jpg" },
{ slug: "dogs", title: "Dogs", image: "/images/dogs.jpg" },
];

---

<PageLayout title="Cards By Margaret">
  <section class="special">
    <div class="special-image">
      <img
        src="/images/rosary_card_front.jpg"
        alt="Rosary Card featuring artwork by Margaret McKeough Breighner"
        loading="lazy"
      />
    </div>

    <div class="special-info">
      <p class="label">SPECIAL CARD</p>
      <h2>A special card<br />for a special occasion.</h2>
      <p>
        A limited-time card featuring Margaret's artwork,
        available in quantities of one to six.
      </p>
      <a class="browse" href="/special-card/">View the special card →</a>
    </div>
  </section>
  <section class="hero">
    <div class="hero-image">
      <a href="/artwork/angels/">
        <img
          src="/images/angels.jpg"
          alt="Angels by Margaret McKeough Breighner"
        />
      </a>
    </div>


<div class="hero-info">
  <div>
    <p class="label">CARDS BY MARGARET</p>
    <h1>Original artwork,<br />made into cards.</h1>
  </div>

  <p class="description">
    Artwork by Margaret McKeough Breighner,
    reproduced as cards and prints.
  </p>

  <a class="browse" href="/artwork/">View the collection →</a>
</div>

  </section>
  

  <section class="collection">

<div class="section-heading">
  <p class="label">THE COLLECTION</p>
  <a href="/artwork/">View all →</a>
</div>

<div class="grid">
  {cards.map((card) => (
    <a class="card" href={`/artwork/${card.slug}/`}>
      <div class="image">
        <img src={card.image} alt={card.title} loading="lazy" />
      </div>
      <div class="caption">
        <span>{card.title}</span>
        <span>→</span>
      </div>
    </a>
  ))}
</div>


  </section>

  <section class="about">


<div class="about-image">
  <img
    src="/images/houses_3.jpg"
    alt="Artwork by Margaret McKeough Breighner"
    loading="lazy"
  />
</div>

<div class="about-text">
  <p class="label">ABOUT</p>
  <h2>Art meant<br />to be shared.</h2>
  <p>
    Cards By Margaret brings Margaret McKeough Breighner's
    original artwork into everyday correspondence.
  </p>
</div>


  </section>

</PageLayout>

<style>
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr);
  gap: 5vw;
  max-width: 1250px;
  margin: 0 auto;
  padding: 4rem 3rem 8rem;
  align-items: center;
}

.hero-image {
  background: #f5f5f3;
}

.hero-image a {
  display: block;
  border: 0;
}

.hero-image img {
  display: block;
  width: 100%;
  height: auto;
}

.hero-info {
  padding-right: 2rem;
}

.label {
  font-size: 10px;
  letter-spacing: .2em;
  color: var(--muted);
  margin: 0 0 1.5rem;
}

h1 {
  font-family: Georgia, serif;
  font-size: clamp(3rem, 5vw, 5rem);
  line-height: .98;
  font-weight: 400;
  letter-spacing: -.03em;
  margin: 0;
}

.description {
  color: var(--muted);
  line-height: 1.7;
  max-width: 330px;
  margin: 2.5rem 0 1.5rem;
}

.browse,
.about-text a {
  border-bottom: 1px solid currentColor;
  padding-bottom: 3px;
}

/* SPECIAL CARD */

.special {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  padding: 2.5rem 3rem 3.5rem;
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 4vw;
  align-items: center;
}

.special-image {
  background: #f5f5f3;
}

.special-image img {
  display: block;
  width: 100%;
  height: auto;
}

.special-info h2 {
  font-family: Georgia, serif;
  font-size: clamp(2.2rem, 4vw, 3.5rem);
  line-height: .98;
  font-weight: 400;
  letter-spacing: -.03em;
  margin: 0 0 1.25rem;
}

.special-info > p:not(.label) {
  max-width: 320px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

/* Divider showing there is more content below */
.special::after {
  content: "";
  position: absolute;
  left: 3rem;
  right: 3rem;
  bottom: 0;
  border-bottom: 1px solid #ddd;
}

/* COLLECTION */

.collection {
  max-width: 1250px;
  margin: 0 auto;
  padding: 0 3rem 9rem;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 1.5rem;
}

.section-heading .label {
  margin: 0;
}

.section-heading a {
  font-size: 13px;
  border-bottom: 1px solid currentColor;
  padding-bottom: 2px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem 1.2rem;
}

.card {
  display: block;
  border: 0;
}

.image {
  background: #f5f5f3;
  overflow: hidden;
}

.card img {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  transition: transform .25s ease;
}

.card:hover img {
  transform: scale(1.02);
}

.caption {
  display: flex;
  justify-content: space-between;
  padding-top: .65rem;
  font-size: 13px;
}

/* ABOUT */

.about {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 3rem 10rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7vw;
  align-items: center;
}

.about-image img {
  display: block;
  width: 100%;
}

.about-text h2 {
  font-family: Georgia, serif;
  font-size: clamp(2.8rem, 5vw, 4.8rem);
  line-height: .95;
  font-weight: 400;
  letter-spacing: -.03em;
  margin: 0 0 2rem;
}

.about-text > p:not(.label) {
  max-width: 360px;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 2rem;
}

/* MOBILE */

@media (max-width: 750px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 2rem 1.5rem 6rem;
    gap: 2.5rem;
  }

  .hero-info {
    padding: 0;
  }

  .hero-info h1 {
    font-size: 3.5rem;
  }

  .special {
    grid-template-columns: 150px 1fr;
    padding: 2rem 1.5rem 3rem;
    gap: 1.5rem;
  }

  .special-info h2 {
    font-size: 2rem;
  }

  .special-info > p:not(.label) {
    font-size: 14px;
  }

  .special::after {
    left: 1.5rem;
    right: 1.5rem;
  }

  .collection {
    padding: 0 1.5rem 6rem;
  }

  .grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem .8rem;
  }

  .about {
    grid-template-columns: 1fr;
    padding: 0 1.5rem 6rem;
    gap: 2.5rem;
  }

  .grid .card:nth-child(n+3) {
    display: none;
  }
}
</style>
